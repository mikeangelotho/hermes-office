{
  "name": "office-hours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3010 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3010 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts server/*.test.ts",
    "test:bridge": "python3 -B -m unittest discover -s bridge/tests -v",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "solid-js": "1.9.18",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
